# Local development (npm run dev). Generate key with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
DB_PATH=./data/mood.sqlite
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development

# Production use: bash deploy/bootstrap.sh, then verify legal details and ACL.
# That installer generates a separate private .env:
# APP_ORIGIN=https://mood.biodata.health
# MOOD_BIND_IP=192.168.31.20
# TRUST_PROXY=0
# NODE_ENV=production
# DATA_CONTROLLER=verified legal operator
# PRIVACY_CONTACT=verified contact
# DNS: mood A 62.152.38.223 (REG.RU)
# HTTPS reverse proxy: 192.168.31.23 -> 192.168.31.20:3001
# See deploy/README.md and deploy/SUPPORT_REQUEST.md.
