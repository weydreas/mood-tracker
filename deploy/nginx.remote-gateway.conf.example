# Example LOCATION ONLY for the SHARED reverse proxy 192.168.31.23.
# Use only if support confirms the existing stack is Nginx and already
# has a valid HTTPS server block for mood.biodata.health.
# Not a complete vhost, TLS certificate, NAT, DNS or firewall configuration.
# DO NOT install this file on backend srv-prod (192.168.31.20).
location / {
    proxy_pass http://192.168.31.20:3001;
    proxy_http_version 1.1;
    proxy_set_header Host mood.biodata.health;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    client_max_body_size 32k;
    proxy_connect_timeout 5s;
    proxy_read_timeout 35s;
    access_log off;
}
